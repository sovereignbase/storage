{
  "type": "module",
  "license": "Apache-2.0",
  "name": "@sovereignbase/storage",
  "version": "2.0.0",
  "description": "Encrypted cache-first object storage for modern browsers.",
  "keywords": [
    "cache-api",
    "encryption",
    "local-first",
    "object-storage",
    "sovereignbase",
    "typescript",
    "web-crypto"
  ],
  "module": "./dist/index.js",
  "browser": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "npm run build:package && npm run build:docs",
    "build:package": "tsdown",
    "build:docs": "typedoc",
    "test": "npm run build && npm run typecheck && npm run test:vitest && npm run test:e2e",
    "typecheck": "tsc --noEmit --project test/tsconfig.json",
    "test:vitest": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@sovereignbase/actor-channel": "^1.2.0",
    "@sovereignbase/bytecodec": "^2.0.1",
    "@sovereignbase/cryptosuite": "^3.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "husky": "^9.1.7",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignbase/storage.git"
  },
  "bugs": {
    "url": "https://github.com/sovereignbase/storage/issues"
  },
  "homepage": "https://sovereignbase.dev/storage"
}
